---
interface Props {
	href: string;
	class?: string;
}

const { href, class: className, ...rest } = Astro.props;
const isExternal = href.startsWith("http");
---

<a
	href={href}
	class={className}
	{...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
	{...rest}
>
	<slot />
</a>
